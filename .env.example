# AgriSense — environment template for the REPO-ROOT .env. Copy to .env and fill.
# .env is gitignored. NEVER commit real values (CLAUDE.md §2.8, NOTES.md #20).
#
# TWO env files exist on purpose — do not merge them:
#   - THIS file (repo root .env) — Supabase identity/auth, the API server's
#     host/port/CORS, and the frontend's VITE_* vars. Loaded explicitly by
#     backend/api/config.py, and by Vite via `envDir: '..'` in vite.config.js.
#   - backend/.env (see backend/.env.example) — the LLM key (OPENAI_API_KEY)
#     and the rest of the agent's runtime config. Loaded explicitly by
#     backend/agent/config.py. Putting the LLM key here instead does nothing
#     useful; the agent looks in backend/.env first.

# ============================================================
# B-owned (api / frontend / finance / payments)
# ============================================================

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated browser origins allowed to call the API.
# Dev normally needs NONE of these: the Vite dev server proxies /api to the
# backend, so the browser sees one origin. Kept for direct-port access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- frontend (Vite: only VITE_* vars reach the browser) ---
# Empty = same-origin + Vite proxy (the dev default; leave empty).
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (backend/api/crops.py proxies the caller's own token to these) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# CLI-only (supabase link / db push); not read by application code.
SUPABASE_DB_PASSWORD=

# --- payments: bdapps CaaS (names per BDAPPS-API-REFERENCE.md) ---
# BDAPPS_MODE=simulator until the portal unblocks. NOTES.md #4.
BDAPPS_MODE=simulator
BDAPPS_BASE_URL=https://developer.bdapps.com
BDAPPS_APP_ID=APP_000xxx
BDAPPS_PASSWORD=
BDAPPS_TEST_MSISDN=

# --- frontend demo-guest bypass (hackathon safety net) ---
# Skip the Supabase login screen entirely and render the app as a local guest
# identity (never sent to Supabase). Same effect as opening the app with
# ?guest=1 in the URL. Leave unset/false for the normal login flow.
VITE_DEMO_GUEST=false

# ============================================================
# A-owned (agent / tools / kb / memory)
# ============================================================
#
# The LLM key does NOT go here. backend/agent/config.py reads backend/.env
# explicitly (parents[1] of backend/agent/config.py) before it ever falls back
# to this file, so OPENAI_API_KEY belongs in backend/.env — see
# backend/.env.example and copy it separately:
#   cp backend/.env.example backend/.env      # then fill in OPENAI_API_KEY

# --- product name (LOG4: the name is not final) ---
BRAND_NAME=AgriSense
VITE_BRAND_NAME=AgriSense

# --- phone channels (LOG4) ---
# Salt for hashing phone numbers into farm ids. Set a long random value before
# any real farmer's number is stored; changing it later orphans existing farms.
CHANNEL_ID_SALT=
# simulator | smsgate | bdapps. simulator = nothing leaves the machine; the
# browser phone emulator reads its inbox.
SMS_PROVIDER=simulator
SMS_MAX_PARTS=3
# SMSGate (Android phone, Local Server mode): shown in the app on the phone.
SMSGATE_URL=http://192.168.0.10:8080
SMSGATE_USER=
SMSGATE_PASSWORD=
# Webhook signing key from the SMSGate app; when set, unsigned webhooks are refused.
SMSGATE_SIGNING_KEY=
# Force the browser emulator on/off (default: on only in simulator mode).
CHANNEL_EMULATOR_ENABLED=
# Shared secret for the laptop-side ADB bridge (python -m backend.channels.bridge.adb).
BRIDGE_TOKEN=
# Proactive weather-alert SMS loop.
ALERT_SMS_ENABLED=false
ALERT_SCAN_HOURS=6

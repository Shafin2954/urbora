# Environment template: the API, the frontend and the phone channels.
# Agent/LLM settings (OPENAI_API_KEY, OPENAI_MODEL…) are documented in backend/.env.example.
#
# Simplest setup: put ALL your real values in ONE file, `.env.local` at the repo root.
# backend/env.py loads `.env.local` > `backend/.env` > `.env` (first value wins; real
# environment variables beat all three), and Vite reads the root `.env` / `.env.local`
# through `envDir: '..'`. Only VITE_* variables ever reach the browser.
#
# All three files are gitignored. NEVER commit real values (AGENTS.md rule 8, docs/NOTES.md #20).

# ============================================================
# B-owned (api / frontend / finance / payments)
# ============================================================

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated browser origins allowed to call the API.
# Dev normally needs NONE of these: the Vite dev server proxies /api to the
# backend, so the browser sees one origin. Kept for direct-port access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- frontend (Vite: only VITE_* vars reach the browser) ---
# Empty = same-origin + Vite proxy (the dev default; leave empty).
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (backend/api/crops.py proxies the caller's own token to these) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# CLI-only (supabase link / db push); not read by application code.
SUPABASE_DB_PASSWORD=

# --- payments: bdapps CaaS (names per docs/channels/BDAPPS-API-REFERENCE.md) ---
# BDAPPS_MODE=simulator until the portal unblocks. docs/NOTES.md #4.
BDAPPS_MODE=simulator
BDAPPS_BASE_URL=https://developer.bdapps.com
BDAPPS_APP_ID=APP_000xxx
BDAPPS_PASSWORD=
BDAPPS_TEST_MSISDN=

# --- frontend demo-guest bypass (hackathon safety net) ---
# Skip the Supabase login screen entirely and render the app as a local guest
# identity (never sent to Supabase). Same effect as opening the app with
# ?guest=1 in the URL. Leave unset/false for the normal login flow.
VITE_DEMO_GUEST=false

# ============================================================
# A-owned (agent / tools / kb / memory)
# ============================================================
#
# The LLM key does NOT go here. backend/agent/config.py reads backend/.env
# explicitly (parents[1] of backend/agent/config.py) before it ever falls back
# to this file, so OPENAI_API_KEY belongs in backend/.env — see
# backend/.env.example and copy it separately:
#   cp backend/.env.example backend/.env      # then fill in OPENAI_API_KEY

# --- product name (LOG.md: the name is not final) ---
BRAND_NAME=Agrosfeer
VITE_BRAND_NAME=Agrosfeer

# --- phone channels (LOG.md) ---
# Salt for hashing phone numbers into farm ids. Set a long random value before
# any real farmer's number is stored; changing it later orphans existing farms.
CHANNEL_ID_SALT=
# simulator | smsgate | bdapps. simulator = nothing leaves the machine; the
# browser phone emulator reads its inbox.
SMS_PROVIDER=simulator
SMS_MAX_PARTS=3
# SMSGate (Android phone, Local Server mode): user/password are shown in the app.
# 127.0.0.1 over USB: `python -m backend.channels.bridge.phone_up` opens the adb tunnels.
SMSGATE_URL=http://127.0.0.1:8080
# Dual-SIM phone: which SIM sends (1 or 2); empty = the phone's default.
SMSGATE_SIM=
# The gateway phone's own number(s), comma-separated: messages from them are never
# answered, so a reply that lands back on the phone cannot start an SMS loop.
CHANNEL_OWN_NUMBERS=
SMSGATE_USER=
SMSGATE_PASSWORD=
# Webhook signing key from the SMSGate app; when set, unsigned webhooks are refused.
SMSGATE_SIGNING_KEY=
# Force the browser emulator on/off (default: on only in simulator mode).
CHANNEL_EMULATOR_ENABLED=
# Shared secret for the laptop-side ADB bridge (python -m backend.channels.bridge.adb).
BRIDGE_TOKEN=
# Proactive weather-alert SMS loop.
ALERT_SMS_ENABLED=false
ALERT_SCAN_HOURS=6

# --- voice line (LOG.md) ---
# Speech-to-text: sarvam when SARVAM_API_KEY is set, else OpenAI gpt-4o-transcribe.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
# Force providers: VOICE_STT=sarvam|openai, VOICE_TTS=sarvam|azure|openai
VOICE_STT=
VOICE_TTS=
# Azure bn-BD voices (Dhaka accent): bn-BD-NabanitaNeural / bn-BD-PradeepNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=bn-BD-NabanitaNeural

# --- marketplaces (LOG.md) — pilot parameters, not data ---
# Input marketplace commission, paid by the dealer (the farmer's price never changes).
MARKET_COMMISSION_PCT=5
# Produce marketplace fee, paid by the buyer on top of the agreed price.
PRODUCE_FEE_PCT=2

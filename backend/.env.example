# Agent/LLM settings. Put real values in the repo-root `.env.local` (or `backend/.env`);
# backend/env.py loads `.env.local` > `backend/.env` > `.env`, first value wins.
# API, frontend and phone-channel settings are in the repo-root .env.example.
# Keep this example CURRENT whenever a new key is introduced (AGENTS.md rule 8).

# ── LLM / agent (OpenAI backend — human A's call, deviates from PRD §11) ──
OPENAI_API_KEY=sk-proj-...              # required
OPENAI_MODEL=gpt-4o                    # tool-calling reliability DEPENDS on this model.
# gpt-4o-mini is known (live-verified 2026-07-25) to skip tool calls entirely
# under this agent's 14-tool loop + long system prompt — it answers from model
# recall instead of calling ask_farmer/rag_query/crop_scorer/etc, with zero
# tool_call SSE events. gpt-4o is verified working on this account. If you
# swap models, replay a live turn and confirm tool_call events actually fire
# before trusting it.
OPENAI_MAX_TOKENS=4000                 # per-turn output cap (streamed)
AGRISENSE_TEMPERATURE=0.0              # 0.0 for tool-calling reliability: at 0.2, ask_farmer fired
                                       # only ~7/9 live runs. Blank = omit (reasoning models reject it).
AGRISENSE_MAX_ITERATIONS=12            # agent loop guard (NOTES #5)
# OPENAI_BASE_URL=                     # optional: proxy / Azure / compatible endpoint

# ── bdapps CaaS (payments) — NOT wired into the agent or UI in this submission.
# The module (backend/payments/) exists but is unreachable from the shipped
# app; these keys are listed only so the example stays honest about what the
# dormant code expects (names per docs/channels/BDAPPS-API-REFERENCE.md: BDAPPS_APP_ID /
# BDAPPS_PASSWORD, not BDAPPS_APP_KEY/BDAPPS_APP_PASSWORD as an earlier draft
# of this file guessed). ──
# BDAPPS_BASE_URL=
# BDAPPS_APP_ID=
# BDAPPS_PASSWORD=
# BDAPPS_MODE=simulator                 # simulator|live — never present simulated as live

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.api.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5000
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.api.main:app",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "backend-sim",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.api.main:app",
        "--port",
        "8020"
      ],
      "port": 8020,
      "env": {
        "SMS_PROVIDER": "simulator",
        "CHANNEL_EMULATOR_ENABLED": "1"
      }
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5010,
      "env": {
        "VITE_PORT": "5010",
        "API_PROXY_TARGET": "http://127.0.0.1:8010"
      }
    }
  ]
}
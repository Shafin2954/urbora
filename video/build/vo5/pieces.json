[
 {
  "i": 0,
  "a": 0.2,
  "b": 3.92,
  "text": "Starting with the narrator."
 },
 {
  "i": 1,
  "a": 5.03,
  "b": 6.11,
  "text": "এ দেশের মাটি উর্বর."
 },
 {
  "i": 2,
  "a": 6.92,
  "b": 8.7,
  "text": "এই মাটি আমাদের সবচেয়ে বড় উপহার।"
 },
 {
  "i": 3,
  "a": 9.24,
  "b": 11.57,
  "text": "তাহলে একুই জমিতে ফলন কমছে কেন?"
 },
 {
  "i": 4,
  "a": 12.42,
  "b": 13.71,
  "text": "প্রশ্ন একটাই উত্তর অনেক।"
 },
 {
  "i": 5,
  "a": 14.16,
  "b": 16.45,
  "text": "আর প্রতিবার সমস্যা হলে তো যাওয়া সম্ভব না।"
 },
 {
  "i": 6,
  "a": 17.1,
  "b": 20.27,
  "text": "অথচ টাকা পাঠাতে এখন আর ব্যাংকে যেতে হয় না, ফোনেই হয়ে যায়।"
 },
 {
  "i": 7,
  "a": 21.04,
  "b": 25.11,
  "text": "তাহলে ব্যাঙ্কে না গিয়েই যেমন কাজ হয়, কৃষি পরামর্শও কি তেমনই ফোনে পাওয়া যায় না?"
 },
 {
  "i": 8,
  "a": 25.93,
  "b": 29.15,
  "text": "জায়, কৃষি পরামর্শ এখন হাতের ফোনে। ঊর্বরা।"
 },
 {
  "i": 9,
  "a": 29.8,
  "b": 30.65,
  "text": "বাটন ফোনেই চলে।"
 },
 {
  "i": 10,
  "a": 31.87,
  "b": 34.16,
  "text": "একটা নম্বর ডায়াল করুন, কয়েকটা বাটন চাপুন,"
 },
 {
  "i": 11,
  "a": 34.67,
  "b": 35.62,
  "text": "Utorashe SMS-e."
 },
 {
  "i": 12,
  "a": 36.73,
  "b": 40.07,
  "text": "কী রোগ, কোন ওষুধ আর আপনার জমিতে ঠিক কতটুকু?"
 },
 {
  "i": 13,
  "a": 40.89,
  "b": 43.36,
  "text": "স্মার্টফোন লিখে বা বলে জিজ্ঞেস করুন।"
 },
 {
  "i": 14,
  "a": 43.84,
  "b": 44.87,
  "text": "উত্তরাশে সাথে সাথেই।"
 },
 {
  "i": 15,
  "a": 45.76,
  "b": 47.91,
  "text": "কিন্তু এই পরামর্শে ভরসা করবেন কেন?"
 },
 {
  "i": 16,
  "a": 49.12,
  "b": 52.31,
  "text": "প্রতিটি পরামর্শ আসে সরকারি তথ্য আর যাচাই করা উৎস থেকে।"
 },
 {
  "i": 17,
  "a": 53.06,
  "b": 54.9,
  "text": "আর না জানলে সোজা সোজি বলে দেয়।"
 },
 {
  "i": 18,
  "a": 56.07,
  "b": 57.54,
  "text": "স্মার্টফোন হোক বা বাটনফোন."
 },
 {
  "i": 19,
  "a": 58.0,
  "b": 58.89,
  "text": "দিনহক বাৰাত."
 },
 {
  "i": 20,
  "a": 60.34,
  "b": 63.51,
  "text": "মাটি আমাদের উপহার, তার যত্নের জ্ঞান এখন সবার হাতে।"
 },
 {
  "i": 21,
  "a": 64.12,
  "b": 64.57,
  "text": "Úrvora."
 },
 {
  "i": 22,
  "a": 65.5,
  "b": 66.25,
  "text": "স্বপ্নফলুক।"
 },
 {
  "i": 23,
  "a": 69.13,
  "b": 69.6,
  "text": "Urgora."
 },
 {
  "i": 24,
  "a": 70.06,
  "b": 70.76,
  "text": "সপন ফলুক."
 },
 {
  "i": 25,
  "a": 73.34,
  "b": 73.73,
  "text": "Mahmud."
 },
 {
  "i": 26,
  "a": 75.46,
  "b": 78.88,
  "text": "গতবার পঞ্চাশ নম্বর পেয়েছিলাম, এবার মাত্র তিরিশ।"
 },
 {
  "i": 27,
  "a": 80.13,
  "b": 81.64,
  "text": "একেকজন একেক কথা বলে।"
 },
 {
  "i": 28,
  "a": 82.15,
  "b": 82.93,
  "text": "কার কথা শুনবো?"
 },
 {
  "i": 29,
  "a": 84.5,
  "b": 86.59,
  "text": "কৃষিঅফিসে যেতে গেলে পুরো একটা দিন শেষ।"
 },
 {
  "i": 30,
  "a": 88.3,
  "b": 90.21,
  "text": "আব্বা সবসময় এটাই দিতো।"
 },
 {
  "i": 31,
  "a": 92.15,
  "b": 94.67,
  "text": "বৃষ্টির আগেই খবর পেলাম, ইউরিয়া টিবেচে গেল।"
 },
 {
  "i": 32,
  "a": 95.51,
  "b": 97.74,
  "text": "জ্যাক, এবার বুঝলাম কি করতে হবে।"
 },
 {
  "i": 33,
  "a": 99.04,
  "b": 99.84,
  "text": "Shopkeeper"
 },
 {
  "i": 34,
  "a": 100.38,
  "b": 103.0,
  "text": "ভাই, এটা নিয়ে যান, এবার সবাই এটাই নিচ্ছে।"
 },
 {
  "i": 35,
  "a": 104.51,
  "b": 104.99,
  "text": "Neighborhood"
 },
 {
  "i": 36,
  "a": 105.85,
  "b": 108.17,
  "text": "আমি তো পটাশ দিয়েছিলাম, কাজ হয়েছে।"
 },
 {
  "i": 37,
  "a": 110.83,
  "b": 111.97,
  "text": "Von Video-YouTubern."
 },
 {
  "i": 38,
  "a": 112.74,
  "b": 113.71,
  "text": "এটা দিলেই হবে।"
 },
 {
  "i": 39,
  "a": 114.78,
  "b": 115.35,
  "text": "Shopkeeper?"
 },
 {
  "i": 40,
  "a": 116.15,
  "b": 116.55,
  "text": "helpful."
 },
 {
  "i": 41,
  "a": 117.42,
  "b": 120.37,
  "text": "ও মাঝারি পোকা? তাহলে এটা নিন। এটুুই লাগবে।"
 },
 {
  "i": 42,
  "a": 121.8,
  "b": 122.56,
  "text": "하겠소."
 }

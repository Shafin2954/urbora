# ── Secrets (CLAUDE.md rule 8 — secrets NEVER touch git) ──
.env
*.env
!.env.example
.env.local
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtualenvs ──
.venv/
venv/
backend/.venv/

# ── Node / frontend (Instance B) ──
node_modules/
dist/
frontend/dev-dist/
.vite/
*.log
npm-debug.log*

# ── Local model / index caches (pre-cached, not committed) ──
backend/kb/.chroma/
backend/kb/chroma_index/
*.onnx
.cache/

# ── OS / editor noise ──
.DS_Store
Thumbs.db
*.swp

# NOTE (B): data/crop.db is deliberately NOT ignored here — PLAN.md §1 leaves
